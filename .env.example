# ==============================================================================
# LifeOS — Environment Configuration Template
# Copy this file to `backend/.env` and update placeholder values with your real credentials.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifeos
TEST_DB_NAME=lifeos_test
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# Security & Authentication
FLASK_ENV=development
SECRET_KEY=generate_a_random_32_character_flask_secret_key_here
JWT_SECRET_KEY=generate_a_random_32_character_jwt_secret_key_here
# Fernet 32-byte url-safe base64 encryption key for OAuth tokens at rest.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-valid-fernet-key

# CORS & Server Settings
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Temporary Video Upload Pipeline Settings
TEMP_UPLOAD_DIR=temp_uploads
MAX_VIDEO_SIZE_MB=500
MAX_THUMBNAIL_SIZE_MB=10
TEMP_FILE_TTL_HOURS=24

# Google OAuth 2.0 & YouTube Data API v3
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/social-media/oauth/youtube/callback

# Meta (Facebook & Instagram Professional) Graph API
# Obtain from: https://developers.facebook.com/apps/
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=http://localhost:5000/api/social-media/oauth/meta/callback
