# ==============================================================================
# LifeOS — Environment Configuration Template
# Copy this file to `backend/.env` and update placeholder values with your real credentials.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifeos
TEST_DB_NAME=lifeos_test
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# Security & Authentication
FLASK_ENV=development
SECRET_KEY=generate_a_random_32_character_flask_secret_key_here
JWT_SECRET_KEY=generate_a_random_32_character_jwt_secret_key_here
# Fernet 32-byte url-safe base64 encryption key for OAuth tokens at rest.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-valid-fernet-key

# CORS & Server Settings
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Temporary Video Upload Pipeline Settings
TEMP_UPLOAD_DIR=temp_uploads
MAX_VIDEO_SIZE_MB=500
MAX_THUMBNAIL_SIZE_MB=10
TEMP_FILE_TTL_HOURS=24

# Google OAuth 2.0 & YouTube Data API v3
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/social-media/oauth/youtube/callback

# YouTube Resumable Publishing Configuration
YOUTUBE_UPLOAD_CHUNK_SIZE_KB=1024
YOUTUBE_UPLOAD_MAX_RETRIES=5
YOUTUBE_UPLOAD_INITIAL_BACKOFF_SECONDS=1.0
YOUTUBE_UPLOAD_CONNECT_TIMEOUT_SECONDS=15
YOUTUBE_UPLOAD_READ_TIMEOUT_SECONDS=60
YOUTUBE_PROCESSING_POLL_INTERVAL_SECONDS=3.0
YOUTUBE_PROCESSING_MAX_POLLS_PER_RUN=10
YOUTUBE_PUBLISH_MAX_WORKERS=3
YOUTUBE_PUBLISH_LEASE_SECONDS=300
ENABLE_YOUTUBE_PUBLISH_WORKER=true

# ==============================================================================
# Meta & Instagram Graph API Configuration (Phase 6 / Stage 6A)
# Obtain from: https://developers.facebook.com/apps/
# Setup Guide: docs/INSTAGRAM_SETUP_GUIDE.md
# ==============================================================================

# Meta App ID (also used as Instagram Client ID)
# Found in Meta Developer App Dashboard -> Settings -> Basic -> App ID
INSTAGRAM_CLIENT_ID=your_meta_app_id_here
META_APP_ID=your_meta_app_id_here

# Meta App Secret (Keep this strictly confidential; NEVER expose to frontend or git)
# Found in Meta Developer App Dashboard -> Settings -> Basic -> App Secret
INSTAGRAM_CLIENT_SECRET=your_meta_app_secret_here
META_APP_SECRET=your_meta_app_secret_here

# Instagram OAuth Redirect URI
# Must match Authorized Redirect URIs in Meta App Dashboard -> Facebook Login -> Settings
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/social-media/oauth/instagram/callback
META_REDIRECT_URI=http://localhost:5000/api/social-media/oauth/meta/callback

# Meta Graph API Version (Do not hardcode API versions in code; update here when bumping API version)
# See: https://developers.facebook.com/docs/graph-api/changelog/
META_GRAPH_API_VERSION=v21.0

# Meta Graph API Base URL
META_GRAPH_API_BASE_URL=https://graph.facebook.com

# Instagram & Meta OAuth Requested Permissions / Scopes (Comma-separated)
# - instagram_basic: Read Instagram account profile info, handle, and media
# - instagram_content_publish: Publish single photos, reels, carousel posts, and videos
# - pages_show_list: List Facebook Pages connected to the user's Meta account
# - pages_read_engagement: Read basic engagement and verify Page to Instagram account linkage
# - business_management: Manage connected business assets and accounts
INSTAGRAM_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement,business_management

